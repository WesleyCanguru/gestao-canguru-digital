{
  "rewrites": [
    {
      "source": "/guia-socios",
      "destination": "/guias/joey/socios.html"
    },
    {
      "source": "/p/alvaro-petrus",
      "destination": "/propostas/alvaro-petrus.html"
    },
    {
      "source": "/p/alvaro-petrus-360",
      "destination": "/propostas/alvaro-petrus-360.html"
    },
    {
      "source": "/g/:slug",
      "destination": "/api/share?path=g/:slug"
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "pouch.joeygrowth.com"
        }
      ],
      "destination": "/api/share?path=:path"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
